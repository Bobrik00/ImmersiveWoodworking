			"type": "None",
			"freshHours": { "avg": 48 },
			"transitionHours": { "avg": 48 },
			"transitionRatio": 1,
			"transitionedStack": { "type": "item", "code": "game:resin" }
		},
		"shape": { "base": "game:block/food/meal/liquid" },
		"ingredients": [
			{
				"code": "tar",
				"validStacks": [ { "type": "item", "code": "immersivewoodworking:barktar" } ],
				"minQuantity": 3,
				"maxQuantity": 3
			}
		],
		"cooksInto": { "type": "Item", "code": "game:resin", "quantity": 3 }
	},
	{
