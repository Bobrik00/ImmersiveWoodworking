{
	// Grid recipe (arm rework, user 2026-07-10) — the ARM (lever/helve that holds the head) `chopperarm`: the pendulum
	// lever the chopperhead-{metal} is set into at assembly (analogue of sawmillsash). Mandatory part; the head installs
	// ONLY after the arm is in (install-order rule, T02.01). An oversized axe helve — a plank shaft banded with a metal
	// sheet and nails, put together with a hammer:
	//   H N _     H = hammer (tag tool-hammer, returned untouched)   N = nails (game:metalnailsandstrips-*)
	//   _ P _     P = plank  (game:plank-* item, name:"wood" — the helve/shaft)
	//   P S P     S = metal plate (game:metalplate-* item — лист металла — the head strap)
	// 3x3 SHAPE, DISTINCT from the other chopper parts and the sawmill's so they don't collide on one grid. game:-prefix
	// on vanilla ingredients (memory vs-mod-asset-path-domain); wildcard by CODE (vs-recipe-ingredient-code-vs-tags);
	// hammer by TAG with no code (any hammer, mod-independent). The `name` keys label which cells are one material, they
	// do NOT force it: cell binding is the RecipeLoader's per-variant expansion, and this enabled:false template is
	// registered from C# instead, which never expands (AuditFixPlan T10.02) — so three planks of three woods are
	// accepted, by design, since the output bakes no species. No
	// head is crafted here — the chopperhead-{metal} is installed into this arm in the world at assembly (E03/T03.07).
	// SHAPE + QUANTITIES are a BALANCE DRAFT (user tunes).
	// enabled:false -> TEMPLATE (RecipeLoader skips it). RegisterChopperRecipes re-registers it once per discovered wood
	// DOMAIN, re-pointing the P (plank) slot (matched by Code.Path prefix, not by letter) to {domain}:plank-* so a wood
	// mod's own-domain planks craft it; the metal/tool slots are left untouched. The game-domain recipe is registered
	// from this same template (vanilla unchanged).
	enabled: false,
	ingredientPattern: "HN_,_P_,PSP",
	ingredients: {
		"H": { type: "item", tags: ["tool-hammer"], isTool: true, toolDurabilityCost: 0 },
		"N": { type: "item", code: "game:metalnailsandstrips-*", name: "metal" },
		"P": { type: "item", code: "game:plank-*",               name: "wood" },
		"S": { type: "item", code: "game:metalplate-*" }
	},
	width: 3,
	height: 3,
	output: { type: "item", code: "chopperarm", quantity: 1 }
}
