{
	// DRAFT grid recipe (T02.03) — part #2: the saw SASH `sawmillsash`. The vertical moving frame the blade kit is
	// inserted into at assembly; blade tension comes from the sash + NAILS (so there is NO separate rope part).
	// CAP: nails `game:metalnailsandstrips-*` ("any nails", any metal).
	//   N P N     N = nails (game:metalnailsandstrips-*)
	//   P _ P     P = plank (game:plank-* item)
	//   N P N
	// game:-prefix required (memory vs-mod-asset-path-domain); output in-domain. Wildcard by CODE (memory
	// vs-recipe-ingredient-code-vs-tags). The `name` keys label which cells are one material, they do NOT force it:
	// cell binding is the RecipeLoader's per-variant expansion, and this enabled:false template is registered from C#
	// instead, which never expands (AuditFixPlan T10.02) — four planks of four woods and four nail strips of four
	// metals are accepted, by design, since the output bakes neither. SHAPE + QUANTITIES TBD (balance). Blades are NOT crafted here — the
	// vanilla sawblade-{metal} kit is installed into this sash in the world at assembly (E03) as a single bladeStack — there is no N-count of blades (N in this recipe is the nails).
	// enabled:false → now a TEMPLATE: RecipeLoader skips it. ImmersiveWoodworkingModSystem.RegisterSawmillRecipes
	// re-registers it once per discovered wood DOMAIN, re-pointing the P (plank) slot to {domain}:plank-* so a wood
	// mod's own-domain planks craft it. The game-domain recipe is registered from this same template (vanilla unchanged).
	enabled: false,
	ingredientPattern: "NPN,P_P,NPN",
	ingredients: {
		"N": { type: "item", code: "game:metalnailsandstrips-*", name: "metal" },
		"P": { type: "item", code: "game:plank-*",               name: "wood" }
	},
	width: 3,
	height: 3,
	output: { type: "item", code: "sawmillsash", quantity: 1 }
}
