{
	// Invisible ghost-filler for the non-master cells of the chopper's footprint — the analogue of the sawmill's
	// `sawmill-ghost` (and vanilla `mppulverizertop`). NEVER hand-placed: the placed `chopper-frame` captures its
	// footprint and SetBlocks these fillers in E03/T03.03, so there is deliberately no `creativeinventory` and
	// `drops:[]` (it is born/dies with the frame, never becomes an item). Its only jobs are to occupy space and
	// route every click/break to the master.
	//
	// T03.01: `class`/`entityClass` below are wired to the now-registered BlockChopperGhost (routing filler) +
	// BEMultiblockChopper (carries the master link `Principal`). The frame SetBlocks these fillers in T03.03; the
	// per-cell collision routing through the master is T03.02. Until placed they are dormant, but the classes register cleanly.
	code: "chopper-ghost",
	class: "iw-chopper-ghost",
	entityClass: "iw-chopper-multiblock",
	// `game:` prefixes REQUIRED on every vanilla ref (memory vs-mod-asset-path-domain). `block/basic/nothing` is the
	// engine's empty shape → invisible. Break-particle colour is borrowed from the master by the routing class (E03).
	shape: { base: "game:block/basic/nothing" },
	blockmaterial: "Wood",
	drops: [],
	sidesolid: { all: false },
	sideopaque: { all: false },
	rainPermeable: true,
	resistance: 3.5,
	lightAbsorption: 0,
	sounds: {
		"place": "game:block/planks",
		"walk": "game:walk/wood",
		"hit": "game:block/planks",
		"break": "game:block/planks"
	},
	// Full-cube collision/selection FALLBACK. The live per-cell-clamped footprint boxes routed through the master
	// are E03/T03.02; until then (and whenever a filler is orphaned) these keep it solid — never a tunnel/hole.
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 }
}
