// HalfLogBlockPlan — половинка бревна как строительный полублок.
//
// ВАРИАНТЫ: halflogslab-{wood}-{skin}-{rot}-{run}-{face}
//   wood — порода. ЭТО ПЛЕЙСХОЛДЕР: реальные состояния подставляются в рантайме (T01.02,
//          ImmersiveWoodworkingModSystem.InjectWoodVariants) из DiscoverWoodSpecies, чтобы порода
//          из ЛЮБОГО wood-мода получила свой вариант. Ванильный loadFromProperties сюда не годится:
//          он читает ОДИН worldproperties-ассет и не видит породы мода, который возит свой (wildcrafttree).
//          Инъекция идёт только на СЕРВЕРЕ — blocktypes серверная категория, клиент получает реестр по сети (T01.01).
//          Список пород ШИРЕ, чем worldproperties: к нему добавляются породы, которые объявлены литеральными
//          состояниями в самих ассетах брёвен (ванильные aged, veryaged, rotten, veryrotten) — половинка
//          штампуется С БРЕВНА, и без этих состояний её плиты просто не существовало бы, а ПКМ молчал.
//          См. ImmersiveWoodworkingModSystem.DiscoverLogOnlySpecies (AuditFixPlan T04.05).
//          Группа `wood` ОБЯЗАНА оставаться массивом `states`: инъекция читает g["states"] as JArray и,
//          не найдя его, молча отступает. Замена на loadFromProperties убьёт все модовые породы.
//   skin — снята ли с бревна кора (AuditFixPlan T04.01). `barked` — обычная половинка, `debarked` — та, что
//          отколота от уже ободранного бревна: геометрия та же, но круглый бок и торцы берут ободранные
//          текстуры (texturesByType ниже). Признак приезжает из атрибута стака половинки и обратно в него же
//          уходит при ломке, см. BlockHalfLogSlab.SkinCode / HalfLogStack.
//          ПОЧЕМУ ОТДЕЛЬНАЯ ОСЬ, А НЕ ВТОРОЕ ЗНАЧЕНИЕ ОСИ ПОРОДЫ: значение породы читается ПОЗИЦИОННО
//          (Variant["wood"], BlockHalfLogSlab.CodeFor), и дефис внутри значения сделал бы разбор неоднозначным.
//          ПОЧЕМУ СРАЗУ ЗА ПОРОДОЙ, А НЕ В КОНЦЕ: все ключи ниже анкерованы либо на слот породы
//          (combustiblePropsByType), либо на rot с двумя частями после него (`*-down-*-*`). Ось перед rot
//          не двигает ни одну из этих опор. (Третьей опорой был креатив-фильтр, анкерованный на ХВОСТ кода
//          шаблоном `*-barked-down-we-split`; AuditFixPlan T04.04 унесла плиту из меню целиком, опоры нет.)
//   rot  — какая половина клетки занята, как у ванильного plankslab (проверено по slab-north: z 0..8).
//   run  — ось, вдоль которой лежит бревно.
//   face — что смотрит наружу от опорной грани: кора или расколотая плоскость. Ось НЕЗАВИСИМА от skin:
//          у ободранной половинки «коровая» сторона это круглый бок без коры, а не другая текстура граней.
//
// skipVariants режет 12 геометрически невозможных пар: лежащее бревно не может стоять вертикально
// (rot=down/up + run=ud), а прижатое к стене не может идти СКВОЗЬ эту стену (rot=north/south + run=ns,
// rot=east/west + run=we). 6x3x2 = 36 минус 12 = 24 ориентации, x2 skin = 48 состояний на породу.
// Ось skin геометрических запретов НЕ добавляет, поэтому список ниже не вырос ни на строку: его ключи
// анкерованы на пару rot+run, а skin стоит левее и вычерпывается той же ведущей `*`.
//
// ШЕЙПЫ: по одному ЗАПЕЧЁННОМУ файлу на состояние, путь собирается плейсхолдерами (идиома ванильного
// slab-{rot}). Никакого shapeByType с rotateX/Y/Z — см. обоснование в tools/gen-halflogslab-shape.py,
// он же их и генерирует. Руками эти 24 файла не править.
//
// ФОРМА КЛЮЧЕЙ *ByType. За rot в коде идут ЕЩЁ ДВЕ части, поэтому все ключи по rot пишутся как
// "*-down-*-*", а НЕ как ванильное "*-down". Части ЛЕВЕЕ rot (порода и skin) в счёт не идут: их
// вычерпывает ведущая `*`, так что появление оси skin (T04.01) не тронуло здесь ни одного ключа.
// Ключ byType матчится глобом по ВСЕЙ строке кода
// (RegistryObjectType.solveByType -> WildcardUtil.Match; `*` проходит сквозь дефисы), то есть "*-down"
// требует, чтобы код КОНЧАЛСЯ на "-down". Ванильные plankslab/stonebrickslab/polishedrockslab на этом
// и погорели: их partialAttachableByType не матчит НИ ОДИН вариант, потому что после rot идёт ещё cover.
// Правильный ванильный образец — stone/quartz/slab.json. Первое совпадение выигрывает и цикл рвётся,
// поэтому catch-all "*" обязан стоять ПОСЛЕДНИМ (см. emitSideAoByType).
//
// ПОВОРОТ КЛЮЧОМ (T05.01/T05.02) ЖИВЁТ В КОДЕ, И ПОЛЯ `behaviors` ЗДЕСЬ НЕТ НАМЕРЕННО. BlockHalfLogSlab реализует
// IWrenchOrientable (BlockHalfLogSlab.Wrench.cs); ItemWrench спрашивает интерфейс у блока ДО поведения
// (ItemWrench.cs:206-215), а Block.GetInterface возвращает сам блок первым (vsapi Block.cs:2706-2723), поэтому
// класс выигрывает безоговорочно. Ванильное поведение WrenchOrientable сюда не годится, и не потому что «сложный
// код»: его `baseCode` ВООБЩЕ НЕ ШАБЛОН, а непрозрачный строковый КЛЮЧ в статический словарь, куда каждый блок с
// этим поведением дописывает свой код (BehaviorWrenchOrientable.cs:31,115-121) — литеральная `*` в ванильном
// "quartzslab-*-{cover}" это мнемоника, а не подстановка. Отсюда: (1) порядок цикла — ординальная сортировка
// ПОЛНОГО кода, то есть даже лучший ключ `halflogslab-{wood}` дал бы down-ns-bark, down-ns-split, down-we-bark,
// down-we-split, east-ns-bark… — блок прыгает из нижней половины клетки в восточную на пятом клике, круг замыкается
// на 48-м; (2) аргумент направления на этом пути ОТБРАСЫВАЕТСЯ (ItemWrench.cs:214-238 идёт только вперёд), то есть
// обратного хода нет; (3) модификатора нет вовсе. Единственное, что тот механизм давал даром — недостижимость
// дыр skipVariants, — здесь воспроизведено ВЫВОДОМ правила run.Axis != rot.Axis, а не перебором.
// Не дописывать сюда ни `behaviors`, ни `baseCode`: это молча вернуло бы односторонний алфавитный цикл на 24 шага.
// `drops` здесь СОЗНАТЕЛЬНО отсутствует, и это финальное состояние (HalfLogBlockPlan T04.04, 2026-08-01).
// Половинку-ПРЕДМЕТ отдаёт КОД: BlockHalfLogSlab.GetDrops / OnPickBlock, потому что JSON-дроп не умеет
// проставить атрибуты wood/woodDomain, без которых порода теряется. Молчание оставляет в поле Drops движковый
// самодроп варианта, которого теперь не видит ни один наш шов. Написать вместо этого `"drops": []` было бы
// ПОВЕДЕНЧЕСКИ тем же самым — вопреки расхожему доводу, подсказку про инструмент это не отняло бы: у
// подставленного самодропа поля Tool нет вовсе (BlockType.CreateBlock пишет только Code/Type/Quantity), а
// Block.GetPlacedBlockInteractionHelp пропускает всякий дроп с Tool == null. Молчание выбрано по другой
// причине: пустой массив — это УТВЕРЖДЕНИЕ «блок не дропает ничего», и оно ложно, тогда как отсутствующий
// ключ честно говорит «JSON-путь дропа здесь не используется».
{
	"code": "halflogslab",
	// Registered in ImmersiveWoodworkingModSystem.Start. Без этой строки блок падает на голый Block, и все породы
	// чужих модов остаются с game:-путями ниже, то есть белыми. Класс ничего не хранит и не тикает: он только
	// переписывает три текстуры под домен породы в OnCollectTextures, до запекания атласа (T03.02).
	"class": "iw-halflogslab",
	"variantgroups": [
		{ "code": "wood", "states": ["placeholder"] },
		{ "code": "skin", "states": ["barked", "debarked"] },
		{ "code": "rot", "states": ["north", "east", "south", "west", "up", "down"] },
		{ "code": "run", "states": ["ns", "we", "ud"] },
		{ "code": "face", "states": ["bark", "split"] }
	],
	"skipVariants": [
		"*-down-ud-*",
		"*-up-ud-*",
		"*-north-ns-*",
		"*-south-ns-*",
		"*-east-we-*",
		"*-west-we-*"
	],
	"shape": { "base": "block/halflogslab/{rot}-{run}-{face}" },
	// ТЕКСТУРЫ. Девять слотов и ДВА РАЗНЫХ ПОТРЕБИТЕЛЯ. Три ключа-МАТЕРИАЛА — это имена, которыми шейп
	// называет свои грани: `wood` круглый бок, `debarked_wood` плоскость раскола, `wood_corner` торец с
	// кольцами; их читает чанк-меш. Шесть ключей-ГРАНЕЙ — мировые направления; их читает долото. Одно
	// другого не заменяет, и оба обязаны быть объявлены.
	//
	// ПОРЯДОК КЛЮЧЕЙ ЗДЕСЬ НЕСУЩИЙ: `wood` обязан оставаться ПЕРВЫМ. Это то, что движок раздаёт всюду,
	// где ему нужна «какая-нибудь текстура блока» — Textures.First(), а Textures это FastSmallDictionary,
	// то есть порядок вставки. Отсюда же и форма записи: три материальных ключа стоят в ПЛОСКОМ `textures`,
	// а не в byType, потому что byType-ключи разбор СНИМАЕТ и дописывает результат В КОНЕЦ
	// (RegistryObjectType.solveByType), так что первым стал бы случайный из шести граневых.
	//
	// ШЕСТЬ ГРАНЕВЫХ КОДОВ (T04.02). Без них долото красит отёсанное полубревно КОРОЙ ЦЕЛИКОМ.
	// BlockEntityMicroBlock.VoxelMaterial.FromBlock спрашивает текстуру по КОДУ ГРАНИ — texSource["north"],
	// ["up"] и так далее — а каждой неразрешённой грани выдаёт один и тот же фолбэк, block.Textures.First().
	// Имён материалов шейпа он не знает вовсе, поэтому до этой задачи все шесть граней брали первый ключ,
	// то есть кору: ни колец на торцах, ни плоскости раскола.
	// Какая грань чем является — свойство СОСТОЯНИЯ, а не блока: две грани вдоль оси бревна (`run`) это
	// торцы, одна грань это плоскость раскола (её направление задаёт пара rot+face), остальные три круглый
	// бок. Правила НЕ ПИСАНЫ РУКАМИ: их печатает tools/gen-halflogslab-shape.py (face_rules и
	// print_face_rules) — тот же скрипт, что печёт 24 шейпа, и он же сверяет правила со всеми 48
	// состояниями. Правку вносить ТАМ и перевставлять блок целиком.
	// Форма ключей обычная для этого файла: одна `-*` на каждую часть кода правее той, на которую ключ
	// анкерован. Два правила порядка, оба обязательные: `debarked`-ключи идут ПЕРВЫМИ (ведущая `*` иначе
	// съела бы их — `*-barked-*` совпадает и с `-debarked-`), а catch-all `*` ПОСЛЕДНИМ, потому что первое
	// совпадение выигрывает и цикл рвётся. У ободранной половинки правил вдвое меньше: круглый бок и
	// плоскость раскола у неё одна и та же текстура.
	//
	// Пути ЗДЕСЬ пиннуты на game: с подстановкой {wood}. Это правильный ответ для 12 ванильных пород и заведомо
	// неверный для пород wood-модов, у которых по game:-пути ничего нет. Домен подставляет КОД: BlockHalfLogSlab
	// переопределяет OnCollectTextures и заменяет слоты (Clone, не мутация) на путь того домена, который реально
	// возит текстуру, по КАЖДОЙ текстуре отдельно — у wildcrafttree кора и торец лежат в своём домене, а debarked
	// у 43 пород из 44 только в game:. Для ванильной породы код не меняет ничего (пути уже совпадают).
	// Почему не индексатор ITexPositionSource: его не видит ни чанк-меш (TesselateBlock не принимает источник
	// текстур вовсе), ни микроблок долота, ни партиклы разрушения, ни FirstTextureInventory. Все они читают
	// block.Textures, поэтому чинить надо именно его и именно до запекания атласа.
	//
	// ЭТИ ПУТИ НЕ ПОСЛЕДНЕЕ СЛОВО, И ЭТО ВАЖНО. BlockHalfLogSlab.RetargetSpeciesTextures в OnCollectTextures
	// ПЕРЕПИСЫВАЕТ все девять слотов, поэтому правка только здесь была бы молча откачена: код решает, какое
	// семейство текстур брать, по той же геометрии и по той же оси skin. Две записи обязаны говорить одно и
	// то же — JSON верен для ванильной породы (её пути уже game:), код доводит до правды модовую, а сверяет
	// их BlockHalfLogSlab.SelfCheck на живом реестре.
	"textures": {
		"wood": { "base": "game:block/wood/bark/{wood}" },
		"debarked_wood": { "base": "game:block/wood/debarked/{wood}" },
		"wood_corner": { "base": "game:block/wood/treetrunk/{wood}" },
		"northByType": {
			"halflogslab-*-debarked-*-ns-*": { "base": "game:block/wood/treetrunk/debarked/{wood}" },
			"halflogslab-*-debarked-*": { "base": "game:block/wood/debarked/{wood}" },
			"*-ns-*": { "base": "game:block/wood/treetrunk/{wood}" },
			"*-south-*-split": { "base": "game:block/wood/debarked/{wood}" },
			"*-north-*-bark": { "base": "game:block/wood/debarked/{wood}" },
			"*": { "base": "game:block/wood/bark/{wood}" }
		},
		"eastByType": {
			"halflogslab-*-debarked-*-we-*": { "base": "game:block/wood/treetrunk/debarked/{wood}" },
			"halflogslab-*-debarked-*": { "base": "game:block/wood/debarked/{wood}" },
			"*-we-*": { "base": "game:block/wood/treetrunk/{wood}" },
			"*-west-*-split": { "base": "game:block/wood/debarked/{wood}" },
			"*-east-*-bark": { "base": "game:block/wood/debarked/{wood}" },
			"*": { "base": "game:block/wood/bark/{wood}" }
		},
		"southByType": {
			"halflogslab-*-debarked-*-ns-*": { "base": "game:block/wood/treetrunk/debarked/{wood}" },
			"halflogslab-*-debarked-*": { "base": "game:block/wood/debarked/{wood}" },
			"*-ns-*": { "base": "game:block/wood/treetrunk/{wood}" },
			"*-north-*-split": { "base": "game:block/wood/debarked/{wood}" },
			"*-south-*-bark": { "base": "game:block/wood/debarked/{wood}" },
			"*": { "base": "game:block/wood/bark/{wood}" }
		},
		"westByType": {
			"halflogslab-*-debarked-*-we-*": { "base": "game:block/wood/treetrunk/debarked/{wood}" },
			"halflogslab-*-debarked-*": { "base": "game:block/wood/debarked/{wood}" },
			"*-we-*": { "base": "game:block/wood/treetrunk/{wood}" },
			"*-east-*-split": { "base": "game:block/wood/debarked/{wood}" },
			"*-west-*-bark": { "base": "game:block/wood/debarked/{wood}" },
			"*": { "base": "game:block/wood/bark/{wood}" }
		},
		"upByType": {
			"halflogslab-*-debarked-*-ud-*": { "base": "game:block/wood/treetrunk/debarked/{wood}" },
			"halflogslab-*-debarked-*": { "base": "game:block/wood/debarked/{wood}" },
			"*-ud-*": { "base": "game:block/wood/treetrunk/{wood}" },
			"*-down-*-split": { "base": "game:block/wood/debarked/{wood}" },
			"*-up-*-bark": { "base": "game:block/wood/debarked/{wood}" },
			"*": { "base": "game:block/wood/bark/{wood}" }
		},
		"downByType": {
			"halflogslab-*-debarked-*-ud-*": { "base": "game:block/wood/treetrunk/debarked/{wood}" },
			"halflogslab-*-debarked-*": { "base": "game:block/wood/debarked/{wood}" },
			"*-ud-*": { "base": "game:block/wood/treetrunk/{wood}" },
			"*-up-*-split": { "base": "game:block/wood/debarked/{wood}" },
			"*-down-*-bark": { "base": "game:block/wood/debarked/{wood}" },
			"*": { "base": "game:block/wood/bark/{wood}" }
		}
	},
	// ОСЬ skin (T04.01) двигает ДВА из трёх материальных слотов, и только их: у ободранной половинки круглый
	// бок берёт `debarked`, а торец — `treetrunk/debarked` (ваниль возит отдельный торец без кольца коры по
	// краю, и ровно им уже красит ободранное бревно на козлах — LogTexSource.ForLog, ветка
	// SawInput.DebarkedLog). Оставить торцу обычный `treetrunk` значило бы вернуть кору на срез, тот же самый
	// баг, только на другой грани. Плоскость раскола у обеих одна: раскол обнажает ту же голую древесину,
	// поэтому `debarked_wood` здесь и не упомянут.
	//
	// ЭТО ДОПИСЫВАЕТСЯ К `textures` ВЫШЕ, А НЕ ЗАМЕНЯЕТ ЕГО, и на этом держится весь порядок ключей:
	// solveByType, найдя под базовым именем УЖЕ ЛЕЖАЩИЙ объект, зовёт JObject.Merge, а не присваивание
	// (RegistryObjectType, декомпилировано из Mods/VSEssentials.dll). Merge правит совпавшие свойства НА
	// МЕСТЕ и не переставляет их, так что `wood` остаётся первым. Catch-all `*` тут поэтому и не нужен:
	// обычной, коровой половинке просто нечего перекрывать.
	"texturesByType": {
		"halflogslab-*-debarked-*": {
			"wood": { "base": "game:block/wood/debarked/{wood}" },
			"wood_corner": { "base": "game:block/wood/treetrunk/debarked/{wood}" }
		}
	},
	"attributes": {
		// Долото разрешено (развилка T03.01 #1, решение — да). Без canChisel:true блок отесать НЕЛЬЗЯ вообще:
		// ItemChisel.cs:339 отсекает всё, у чего DrawType != Cube и shape.base != block/basic/cube, а у нас
		// свой шейп. chiselShapeFromCollisionBox берёт объём вокселей из БОКСА КОЛЛИЗИИ, а не из шейпа —
		// у нас это ровно половина клетки, выровненная по сетке 1/16, так что 2048 вокселей получаются точно.
		// Цена решения: материал отёса хранится СЫРЫМ block id в дереве BE, поэтому схему кода варианта
		// halflogslab-{wood}-{skin}-{rot}-{run}-{face} и нормализацию кода породы после ОТГРУЗКИ менять нельзя.
		// Само «после релиза» ещё не наступило: 1.3.0 в ModDB не уходила, поставленных плит в чужих мирах нет,
		// и именно поэтому ось skin (T04.01) вставлена в схему без ремапа. Заморозка включится с первой
		// ПУБЛИКАЦИИ, которая везёт этот блок, а не с первой сборки, которая его содержит.
		"canChisel": true,
		"chiselShapeFromCollisionBox": true,
		// Из какого слота брать ОДИН цвет, представляющий блок целиком (цвет-иконка стака, партиклы падения).
		// Прибито к `wood` намеренно, и это прямое следствие появления граневых кодов выше: без этой строки
		// Block.LoadTextureSubIdForBlockColor предпочитает слот `up` и лишь потом падает на Textures.First()
		// (Block.cs:497-508), а `up` у нас теперь есть — и у него РАЗНОЕ содержимое по ориентациям, так что
		// одна и та же порода получала бы разный цвет в зависимости от того, как её положили. Круглый бок это
		// то, чем половинка ЯВЛЯЕТСЯ, поэтому он и остаётся ответом на вопрос «какого цвета этот блок».
		// Партиклов РАЗРУШЕНИЯ это не касается и не должно: у них грань есть (Block.GetRandomColor читает
		// Textures[facing.Code] и только потом фолбэчится), и с этой задачи они наконец сыплются по месту —
		// голой древесиной с плоскости раскола, кольцами с торца.
		"textureCodeForBlockColor": "wood",
		// Плита не показывается игроку НИГДЕ, где он листает: ни в креативе, ни в справочнике (AuditFixPlan T04.04).
		// Вещь одна — половинка бревна, — и выставлен из неё ровно ПРЕДМЕТ: его кладут, он становится этим
		// блоком, а сломанный блок отдаёт обратно предмет, а не блок. Пока блок стоял в креативе, на одну вещь
		// приходилось 13 записей на ванили и 58 на модпаке, и взятый оттуда блок-стак вёл себя иначе, чем
		// предмет: он ставился всегда состоянием `down-we-split`, куда бы игрок ни целился, потому что
		// TryPlaceBlock здесь не переопределён, а ориентацию из прицела выводит ItemHalfLog.
		//
		// Гасят страницу ДВЕ строки, и обе нужны. `exclude` — прямой запрет: GetHandBookStacks (vsapi
		// Collectible.cs) отдаёт null первым же условием. Пустой creativeinventory ниже убирает запись из меню,
		// и он же убрал бы страницу сам по себе (нет ни одной вкладки — нет и стаков), но молча: вернув фильтр,
		// сопровождающий вернул бы и 57 страниц, не заметив этого. Ровно эту пару несёт choppingblock_legacy.json.
		//
		// ЧТО УЕХАЛО ВМЕСТЕ СО СТРАНИЦЕЙ, чтобы не искать потом. Справочник собирает `allStacks` ровно из
		// GetHandBookStacks всех коллектиблов (SurvivalHandbook.SetupBehaviorAndGetItemStacks), и раздел
		// «Obtained by breaking» на странице ПРЕДМЕТА перебирает этот же список. Плиты в нём больше нет, значит
		// нет и раздела — а с ним стали мертвы `groupBy`, схлопывавший 57 породных значков в один
		// перелистывающийся, и BlockHalfLogSlab.GetDropsForHandbook, чей единственный потребитель — тот раздел.
		// Оба сняты этой же задачей. Откуда берётся половинка, теперь сказано прозой на её собственной странице
		// (`halflog-handbook-text`), а поворотами в мире распоряжаются подсказки `blockhelp-halflogslab-*`.
		// Текст самой плиты (`halflogslab-handbook-title`/`-text`, T06.02) снят по решению автора: не сокращён
		// и не переписан, а убран — он игрока только путал (F-PT-03). Заодно ушёл поиск по породе в справочнике
		// (GuiDialogHandbook.FilterItems отбрасывает скрытые страницы ДО матчинга запроса) — цена принята.
		"handbook": { "exclude": true },
		// Читается ТОЛЬКО BlockSign/BlockSignPost и только для горизонтальной грани: позволяет повесить
		// табличку на грань, которую CanAttachBlockAt отверг. Нужно лишь горизонтальным половинкам (down/up),
		// у стеновых опорная грань и так solid.
		"partialAttachableByType": {
			"*-down-*-*": true,
			"*-up-*-*": true
		},
		// Массив ПО ИНДЕКСУ ГРАНИ [north, east, south, west, up, down], высота барьера 0..1 (Block.cs:2895).
		// Движок сначала выводит его из SideSolid (solid -> 1, иначе 0), потом перекрывает первыми N значениями.
		// Переопределение нужно ТОЛЬКО нижней половинке: её SideSolid даёт по бокам 0, а физически она держит
		// воду до y=0.5. У верхней барьер от пола выразить нечем (высота считается снизу), у стеновых опорная
		// грань уже даёт 1 сама. Четыре значения — намеренно: up/down остаются на своих значениях из SideSolid.
		"liquidBarrierOnSidesByType": {
			"*-down-*-*": [0.5, 0.5, 0.5, 0.5]
		}
	},
	"blockmaterial": "Wood",
	// КРЕАТИВ (AuditFixPlan T04.04): плиты в меню НЕТ ни в одной вкладке. Пустая строка — не «взять всё», а шаблон,
	// которому не отвечает ни один код: BlockType.GetCreativeTabs (VSEssentials.dll, Vintagestory.ServerMods.NoObf)
	// зовётся по разу на вариант и кладёт в CreativeInventoryTabs только совпавшие вкладки, так что здесь
	// каждому из 2736 вариантов достаётся массив нулевой длины. Та же идиома «ноль вкладок» стоит в
	// choppingblock_legacy.json. Игрок получает половинку ПРЕДМЕТОМ и кладёт её сам; обоснование, почему
	// выставлен именно предмет, — у `handbook` выше.
	//
	// Ключ оставлен на месте (а не удалён) как ЯКОРЬ для трёх ловушек этого механизма, каждая из которых
	// возвращает семейство в меню и в справочник молча:
	//   1. Вкладка добавляется по разу НА КАЖДЫЙ совпавший шаблон и НЕ дедуплицируется, так что два
	//      пересекающихся шаблона в одном списке положат блок в креатив ДВАЖДЫ.
	//   2. `creativeinventoryStacks` (через `s`) не фильтруется ВООБЩЕ: BlockType.CreateBlock копирует его на
	//      КАЖДЫЙ вариант, то есть здесь это 2736 копий каждого стака, и вкладки он задаёт сам, мимо этой строки.
	//   3. `handbook.include` перебивает проверку вкладки внутри GetHandBookStacks, так что поставленный без
	//      `byType` он разом вернёт в справочник все 48 состояний каждой породы (на этом уже погорели
	//      chopper/frame.json и sawmill/frame.json — там был include:true без byType).
	// Все три случая ловит машинная проверка в BlockHalfLogSlab.SelfCheck: она утверждает, что в креативе ноль
	// вариантов и ни один не несёт ни `creativeinventoryStacks`, ни `handbook.include`.
	"creativeinventory": { "general": [""] },
	"collisionboxByType": {
		"*-north-*-*": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 1, "z2": 0.5 },
		"*-east-*-*": { "x1": 0.5, "y1": 0, "z1": 0, "x2": 1, "y2": 1, "z2": 1 },
		"*-south-*-*": { "x1": 0, "y1": 0, "z1": 0.5, "x2": 1, "y2": 1, "z2": 1 },
		"*-west-*-*": { "x1": 0, "y1": 0, "z1": 0, "x2": 0.5, "y2": 1, "z2": 1 },
		"*-up-*-*": { "x1": 0, "y1": 0.5, "z1": 0, "x2": 1, "y2": 1, "z2": 1 },
		"*-down-*-*": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.5, "z2": 1 }
	},
	"selectionboxByType": {
		"*-north-*-*": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 1, "z2": 0.5 },
		"*-east-*-*": { "x1": 0.5, "y1": 0, "z1": 0, "x2": 1, "y2": 1, "z2": 1 },
		"*-south-*-*": { "x1": 0, "y1": 0, "z1": 0.5, "x2": 1, "y2": 1, "z2": 1 },
		"*-west-*-*": { "x1": 0, "y1": 0, "z1": 0, "x2": 0.5, "y2": 1, "z2": 1 },
		"*-up-*-*": { "x1": 0, "y1": 0.5, "z1": 0, "x2": 1, "y2": 1, "z2": 1 },
		"*-down-*-*": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.5, "z2": 1 }
	},
	// Одна сплошная грань на состояние — та, которой половинка прижата к соседу; она же единственная,
	// чью грань у соседа можно отсечь при тесселяции. Остальные пять ОБЯЗАНЫ быть false, иначе у соседей
	// появятся дыры. Сокращение сеет СРАЗУ ТРИ словаря: SideSolid, SideOpaque и EmitSideAo (не SideAo,
	// что бы ни утверждала официальная документация). Поэтому ниже НЕ пишем sideSolid/sideOpaque отдельно: они
	// заполняются только там, где ключа ещё нет, и любая своя запись целиком подавила бы это сокращение.
	"sideSolidOpaqueAoByType": {
		"*-north-*-*": { "all": false, "north": true },
		"*-east-*-*": { "all": false, "east": true },
		"*-south-*-*": { "all": false, "south": true },
		"*-west-*-*": { "all": false, "west": true },
		"*-up-*-*": { "all": false, "up": true },
		"*-down-*-*": { "all": false, "down": true }
	},
	// Затеняются ли собственные грани блока. Это движковый дефолт, выписанный явно ради ванильного
	// паритета (plankslab делает так же) — сокращение выше сюда НЕ дотягивается, так что молчание тут
	// значило бы «не думали», а не «оставили как есть».
	"sideAo": { "all": true },
	// А это — отбрасывает ли блок затенение на СОСЕДА. Горизонтальные половинки затеняют только через
	// свою плоскую грань, стеновые не затеняют вовсе: тонкая пластина, светящая AO вбок, даёт уродливые
	// тёмные полосы. Выписать обязательно: без этого ключа EmitSideAo унаследует картину из
	// sideSolidOpaqueAo и стеновые начнут затенять вбок. "*" ПОСЛЕДНИМ — первое совпадение выигрывает.
	"emitSideAoByType": {
		"*-up-*-*": { "all": false, "up": true },
		"*-down-*-*": { "all": false, "down": true },
		"*": { "all": false }
	},
	// Прочность 3.5 (развилка T03.01 #3) — ровно как у planks, supportbeam и у всех деревянных блоков
	// самого мода (колода, рамы лесопилки и колуна). Ваниль НЕ уменьшает resistance за половинный объём:
	// cobbleslab 4 == cobblestone 4, brickslab 2 == brick 2. Двойка у plankslab — не авторское число,
	// а движковый дефолт из-за отсутствующего поля.
	"resistance": 3.5,
	// requiredMiningTier НЕ ЗАДАН намеренно (та же развилка). У ванильных брёвен он равен 1, но это не
	// замедление, а полная блокировка: при тире 1 пустая рука вычитает ноль, и блок не сломать вообще
	// ничем, кроме топора или пилы из металла (нож, кирка, лопата и даже каменная пила отпадают, потому
	// что их miningSpeeds не содержит материал Wood). Для блока, который игрок ставит и переставляет
	// в стройке, это враждебно. Вся ванильная строительная семья (planks/slab/stairs) и собственная
	// колода мода идут тиром 0; топор всё равно остаётся правильным инструментом — скорость даёт
	// blockmaterial Wood через miningspeedbytype топора, а не тир.
	//
	// Плотность 700 = семья брёвен (log/debarkedlog/logsection/logquad и колода мода). Задавать
	// ОБЯЗАТЕЛЬНО: движковый дефолт 2000, а это >= 1000, то есть блок тонул бы. Предмет-половинка
	// стоит на 600 — расхождение известное и безвредное, оба значения ниже 1000, то есть оба плавучие.
	"materialDensity": 700,
	// Горючесть 750/42 (развилка T03.01 #2) — один в один с itemtypes/halflog.json, чтобы поставленный
	// блок не оказался ни выгоднее, ни невыгоднее переносимой половинки. Одно значение на все породы:
	// калибровка предмета тоже плоская, а по породам ваниль различает только полные брёвна.
	// Побочное следствие, о котором надо помнить: combustibleProps сам по себе делает блок ГОРЮЧИМ,
	// так что пол из полубрёвен горит дольше, чем пол из plankslab (600/10). Это последовательно —
	// древесины в нём вчетверо больше.
	//
	// ИСКЛЮЧЕНИЕ: окаменевшее дерево. Список пород к нам приходит НЕ ванильный — DiscoverWoodSpecies
	// читает worldproperties всех доменов, а Wildcraft Trees возит там породу `petrified` (камень, не
	// древесина) и гасит ей горючесть строкой `*-petrified-*: null` в 14 своих ассетах — включая ВСЕ,
	// которым мы прямая родня: бревно, ошкуренное бревно, доски, полублок, лестницу, балку и предмет-доску.
	// (Ровно у них это не везде: в ящике, лестнице-стремянке, люке, секции бревна и ещё четырёх блоках
	// исключение забыто. То есть намерение однозначное, применено неровно; мы берём намерение.) Без этой строки
	// окаменевшее полубревно у нас горело бы 42 с и вдобавок распространяло огонь (BEBehaviorBurning
	// считает топливом всё, у чего BurnDuration > 0), то есть ровно то свойство, которое чужой мод убрал
	// намеренно. Плотность при этом Wildcraft оставляет плоской, так что materialDensity выше трогать не надо.
	// `charred` НЕ исключаем: это продукт обугливания, он гореть должен, и сам Wildcraft его не гасит.
	// Ключ анкерован на СЛОТ ПОРОДЫ (сразу после базового кода), а не написан по образцу rot-ключей выше:
	// там за rot следуют ещё две части, здесь за породой три. Catch-all последним — первое совпадение выигрывает.
	"combustiblePropsByType": {
		"halflogslab-petrified-*": null,
		"*": { "burnTemperature": 750, "burnDuration": 42 }
	},
	// Префикс game: ОБЯЗАТЕЛЕН: голый "block/planks" резолвится в домен immersivewoodworking, где .ogg нет,
	// и блок молча немеет (на этом уже погорели колода и запечатанный дегтярный горшок). byTool даёт
	// бревенчатый «чак» под топором — ровно как у ванильных log/debarkedlog/logsection; на скорость
	// добычи он НЕ влияет, это только звук.
	"sounds": {
		"place": "game:block/planks",
		"walk": "game:walk/wood",
		"hit": "game:block/planks",
		"break": "game:block/planks",
		"byTool": {
			"Axe": { "hit": "game:block/chop", "break": "game:block/planks" }
		}
	},
	// 16 — как у предмета-половинки и у ванильного бревна (доски стакаются по 32, но это распиленный товар).
	"maxStackSize": 16,
	// Носится двумя руками, как бревно и как сама половинка. heldblockready — ванильный паритет и, по факту,
	// пустышка: анимации с таким именем нет ни в ассетах, ни в движке, а StartAnimation на неизвестный
	// метакод молча возвращает false. Ставим потому, что так делают все 166 ванильных блоков.
	"heldTpIdleAnimation": "holdbothhandslarge",
	"heldRightReadyAnimation": "heldblockready",
	"heldTpUseAnimation": "twohandplaceblock",
	// Числа взяты у ванильного plankslab: его shape block/basic/slab/slab-down.json это from [0,0,0] to
	// [16,8,16], то есть ГЕОМЕТРИЧЕСКИ тот же бокс, что и наши down-состояния, — переносятся один в один.
	// origin.y = 0.25 это центр нижней половинки, translation.y = +2 доводит иконку до центра ячейки.
	// Изометрический поворот выписан ЯВНО, хотя plankslab его опускает: под обеими трактовками слияния
	// частичного guiTransform результат один и тот же, а гадать не приходится. И главное — у КАЖДОГО
	// вектора выписаны все три компоненты: FastVec3f это структура, слить в неё Json.NET не может, так что
	// частично записанный вектор (translation только по y) обнулил бы x и z.
	"guiTransform": {
		"translation": { "x": 0, "y": 2, "z": 0 },
		"rotation": { "x": -22.6, "y": -45.3, "z": 0 },
		"origin": { "x": 0.5, "y": 0.25, "z": 0.5 },
		"scale": 1
	},
	"tpHandTransform": {
		"translation": { "x": -1.49, "y": -0.22, "z": -0.7 },
		"rotation": { "x": 6, "y": 16, "z": 98 },
		"origin": { "x": 0.5, "y": 0.25, "z": 0.5 },
		"scale": 0.4
	}
}
