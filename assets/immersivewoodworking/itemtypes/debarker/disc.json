{
	code: "debarkerdisc",
	// The debarker's DISC (AutoDebarkerPlan T02.01): the spinning disc with its hub and the knife nuts. It sits on the
	// frame's input spindle and turns 1:1 with the network shaft as soon as it is in, even on an incomplete machine. A
	// plain Item on purpose: no `class`/`tool`/`behaviors`. RMB-installed into the placed `debarker-frame` in T03.06,
	// in any order with the drive and the feed; the knives install only after it.
	// Held mesh = the disc's elements of the machine model, copied into the Blender collection debarking-PreviewMeshes
	// (art/shapes/LogForChoppingFirewood.blend) and laid flat, knife nuts up. Raw export in art/shapes/debarker/disc.json,
	// this copy has its textures re-pinned to game: paths.
	shape: { base: "immersivewoodworking:item/debarker/disc" },
	// Two-handed carry like every chopper part (decision T02.01, В9).
	heldTpIdleAnimation: "holdbothhandslarge",
	// "game:" REQUIRED (memory vs-mod-asset-path-domain).
	textures: {
		"metal": { base: "game:block/metal/plate/iron" }
	},
	creativeinventory: { "general": ["*"], "items": ["*"] },
	// Handbook back-link to the assembled machine, shared by all installed parts.
	attributes: {
		handbook: {
			extraSections: [
				{ title: "immersivewoodworking:debarkerpart-handbook-title", text: "immersivewoodworking:debarkerpart-handbook-text" }
			]
		}
	},
	// Transforms calibrated in game with .tfedit at T03.05 (2026-11-21).
	// The editor leaves out a value equal to the item default, so the tp scale is that default, 0.33, written out.
	// `rotate: false` stops the icon from spinning, and every vector is written with all three components: a partial
	// vector zeroes the rest (memory vs-partial-guitransform-no-merge).
	tpHandTransform: {
		translation: { x: -1.55, y: -1.5, z: -0.6 },
		rotation: { x: 10, y: 0, z: 2 },
		scale: 0.33
	},
	groundTransform: {
		translation: { x: 0, y: 0.275, z: 0 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0.5, z: 0.5299 },
		scale: 2.68
	},
	guiTransform: {
		rotate: false,
		translation: { x: 3, y: 6, z: 0 },
		rotation: { x: -31, y: -118, z: 20 },
		origin: { x: 0.5, y: 0.5, z: 0.5 },
		scale: 0.65
	}
}
