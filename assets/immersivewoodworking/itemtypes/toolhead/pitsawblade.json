{
	// Pit saw BLADE — the forged toolhead `pitsawblade-{metal}` that becomes a pit saw once hafted + bound
	// (blade + handle + rope → pitsaw-{metal}, T02.01/T02.03). Authored as an ordinary vanilla toolhead, 1:1 with
	// barkspudhead.json, so it rides the whole stock pipeline for free: forged on an anvil (T01.03), Quenchable,
	// GroundStorable, handbook-grouped.
	//
	// WHY pit saw needs its OWN head (locked 2026-06-30, memory vs-toolsmith-integration-plan): Toolsmith maps
	// exactly ONE head → ONE tool (first grid recipe wins), and the vanilla `game:sawblade` is already bound to the
	// vanilla saw. A tinkered tool is strictly 1 head + 1 handle + 1 binding, so a "two-blade" pit saw is impossible
	// without forking Toolsmith. Hence the pit saw gets a dedicated single blade head here.
	//
	// METALS = the FULL vanilla tool set, identical to the vanilla saw / this mod's pitsaw / barkspudhead (copper
	// through steel, incl. soft gold/silver). The metal is a DURABILITY tier on the assembled tool, NOT a speed
	// tier — speed is by tool TYPE plus sharpness (E03), so a copper and a steel pit saw rip at the same base rate.
	//
	// The code intentionally contains "blade" so Toolsmith's toolhead regex ("head"/"blade",
	// config/toolsmith/regex/toolheads/toolheads-base.json) classifies it as a HEAD. But naming alone is NOT
	// enough (verified against decompiled Toolsmith 1.2.17, T02.04/memory vs-toolsmith-compat): Toolsmith only
	// attaches the ToolHead behavior to a head when a grid recipe produces an OUTPUT already registered as a
	// Tinkerable Tool (RecipeRegisterModSystem.AssetsFinalize gates head capture on the recipe output, not the
	// head's name). So this head becomes workbench-tinkerable ONLY because we register the assembled `pitsaw` as
	// tinkerable via config/toolsmith/regex/tinkerabletools/tinkerabletools-immersivewoodworking.json (T02.03).
	// The assembled `pitsaw` contains neither "head" nor "blade", so it is never mis-detected as a part.
	code: "pitsawblade",
	variantgroups: [
		{ code: "metal", states: ["copper", "tinbronze", "bismuthbronze", "blackbronze", "gold", "silver", "iron", "meteoriciron", "steel"] },
	],
	// Iron/meteoric/steel come off the anvil hot and can be quenched (mirrors vanilla hammerhead/axehead and
	// barkspudhead). GroundStorable lays the blade FLAT on the ground like a vanilla axe/shovel/hammer head —
	// Shift+RMB to place, up to 4 per block (Quadrants layout), no wall required. Identical to barkspudhead.
	behaviorsByType: {
		// iw-toolsmithbenchmesh: Toolsmith-only render shim — swaps to the floor-origined item/pitsaw-head-toolsmith
		// shape ONLY while this head sits in a Toolsmith workbench slot (whose hardcoded transform seats a part by
		// its shape geometry, ignoring all item transforms); returns null everywhere else so inventory/hand/ground
		// keep the normal centred item/pitsaw-head. Inert without Toolsmith. behaviorsByType matches ONE key, so it
		// must be in BOTH lists. Replaces the deleted global patch patches/toolsmith_head_shape.json.
		"@(.*-steel|.*-meteoriciron|.*-iron)": [
			{ name: "GroundStorable", properties: { layout: 'Quadrants', collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.125, z2: 1 } } },
			{ name: "Quenchable" },
			{ name: "iw-toolsmithbenchmesh" }
		],
		"*": [
			{ name: "GroundStorable", properties: { layout: 'Quadrants', collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.125, z2: 1 } } },
			{ name: "iw-toolsmithbenchmesh" }
		]
	},
	heldTpUseAnimation: "interactstatic",
	maxstacksize: 4,
	// Blender-authored blade — the metal blade of the pit saw (spine + teeth + reinforcement bands), authored
	// separately by the user as art/shapes/pitsaw-head.json and deployed (with its
	// #null tooth back-faces remapped to #metal + a game: fallback path) to shapes/item/pitsaw-head.json. The
	// model FILE keeps its authored name "pitsaw-head"; the ITEM is named/coded as a "blade" — the code contains
	// "blade" for Toolsmith head-detection, but the player-facing name is "blade", never "head" (T01.04). Its
	// whole body is metal; the shape's lone texture key "metal" is overridden per-variant below.
	// "immersivewoodworking:" = the model lives in THIS mod's domain.
	shape: { base: "immersivewoodworking:item/pitsaw-head" },
	// Per-variant ingot colour, like every vanilla toolhead. "game:" required — an unqualified path resolves to
	// this mod's domain, where the vanilla ingot textures don't exist (memory vs-mod-asset-path-domain).
	textures: {
		"metal": { base: "game:block/metal/ingot/{metal}" }
	},
	attributes: {
		// Re-heatable in a forge (so iron/steel can be re-quenched), and grouped by metal in the handbook —
		// same as vanilla toolheads / barkspudhead. Anvil forging recipe is T01.03; on-tong / in-forge framing
		// transforms are seeded below from barkspudhead and tuned in-game with .tfedit.
		forgable: true,
		handbook: {
			groupBy: ["pitsawblade-*"]
		},
		// Poses the blade as it lies ground-stored (GroundStorable Quadrants layout); tuned in-game with .tfedit.
		groundStorageTransform: {
			translation: { x: 0, y: -0.475, z: 0 },
			rotation: { x: -4, y: -17, z: -6 },
			scale: 0.72
		},
		// Framing while held over the firepit/forge and while gripped in tongs; tuned in-game with .tfedit.
		// Tong pose is per tong TYPE: WOODEN tongs (game:tongs) → onTongTransform, METAL tongs (game:tongsmetal)
		// → onMetalTongTransform (ItemTongs.cs). A MISSING onMetalTongTransform falls back to onTongTransform for
		// BOTH read AND write, so both keys must physically EXIST here or .tfedit can never tune the metal grip
		// apart from the wooden one — hence both are present. Seeded from barkspudhead; re-tune for the blade.
		inForgeTransform: {
			translation: { x: 0, y: -0.42, z: 0.02 },
			rotation: { x: 0, y: 53, z: 13 },
			scale: 0.79
		},
		onTongTransform: {
			translation: { x: -1.2, y: -0.85, z: -0.5 },
			rotation: { x: -88, y: -27, z: -80 },
			scale: 0.89
		},
		onMetalTongTransform: {
			translation: { x: -1.1, y: -0.69, z: -0.5 },
			rotation: { x: -88, y: -27, z: -80 },
			scale: 0.89
		}
	},
	creativeinventory: { "general": ["*"], "items": ["*"] },
	// Starting display transforms seeded from barkspudhead; fine-tune in-game with .tfedit once the blade shape
	// (T01.02) is in (the mod's standard workflow — see pitsaw.json / barkspudhead.json).
	// guiTransform подобран в игре пользователем (2026-07-08) под форму полотна.
	guiTransform: {
		translation: { x: -4, y: 2, z: 0 },
		rotation: { x: 78, y: 48, z: -165 },
		origin: { x: 0.5299, y: 0.48, z: 0.4 },
		scale: 2.26
	},
	groundTransform: {
		translation: { x: 0, y: 0.03, z: 0 },
		rotation: { x: -7, y: -11, z: -2 },
		origin: { x: 0.5, y: 0.5, z: 0.45 },
		scale: 3.54
	},
	tpHandTransform: {
		translation: { x: -0.8, y: -0.5, z: -0.52 },
		rotation: { x: 0, y: -3, z: 0 },
		scale: 0.94
	}
}
