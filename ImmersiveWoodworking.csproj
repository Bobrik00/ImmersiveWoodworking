<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Diagnostic [IW-DBG] logging (BlockChoppingBlock.Dbg / DbgLog) is gated behind the IW_DEBUG compile
       symbol. It is OFF by default: a plain `dotnet build` or `dotnet build -c Release` (the shipped mod)
       strips every Dbg/DbgLog call at compile time — arguments included — so nothing logs and there is zero
       runtime cost. The dev workflow turns it ON: tools/apply-animation.ps1 builds with -p:IwDebug=true.
       The IwDebug build ALSO redirects OutputPath to a SEPARATE folder (bin\$(Configuration)-iwdebug\Mods\mod)
       so a logging-on assembly can never be left behind in the shipped bin\$(Configuration)\Mods\mod and get
       packaged by mistake — the two builds no longer share an output dir, so no manual clean is required.
       (tools/apply-animation.ps1 -Run launches from the -iwdebug path to match.) -->
  <PropertyGroup Condition="'$(IwDebug)' == 'true'">
    <DefineConstants>$(DefineConstants);IW_DEBUG</DefineConstants>
    <OutputPath>bin\$(Configuration)-iwdebug\Mods\mod</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Used to parse + filter the vanilla firewood grid-recipe asset in AssetsLoaded (disable only the
         firewood-producing recipes rather than blanking the whole file). Newtonsoft ships with the game. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The automated sawmill (E04) is a consumer on the vanilla mechanical-power network, so it needs the
         Vintagestory.GameContent.Mechanics types (BEBehaviorMPConsumer / BEBehaviorMPBase / BlockMPBase /
         IMechanicalPowerBlock / MechanicalNetwork). Those live in VSSurvivalMod.dll, NOT VintagestoryAPI.dll —
         the rest of the mod only used the API, this is the first feature that reaches into the survival mod. -->
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

<ItemGroup>
  <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <!-- Assets are copied as-is (PreserveNewest). BUILD CONTRACT for the player-animation patches:
       patches/woodchop_animations.json and patches/sawing_animations.json are NOT regenerated by the build —
       only SawdustPoints.cs is (see the GenerateSawdustPoints target below). The two animation patches are
       authored output of tools/apply-animation.ps1 / apply-sawing-animation.ps1, regenerated from a Blender
       re-export. test.bat runs both generators (in order) before compiling; a plain `dotnet build` / IDE build
       ships whatever patch JSON is currently on disk. So: after re-exporting an animation, run test.bat (or the
       matching apply-*.ps1 -Build) — do NOT rely on a bare build to refresh the animation patches. (They are
       deliberately NOT auto-regenerated like SawdustPoints, because they only change on a deliberate re-export,
       whereas the sawdust point VALUES are edited inline in the .ps1 and easy to forget to re-run.) -->
  <Content Include="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Content Include="modicon.png" Condition="Exists('modicon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

  <!-- Auto-regenerate the sawdust particle points (SawdustPoints.cs) from tools/apply-sawdust-points.ps1 BEFORE
       every compile, so editing the point VALUES in that .ps1 always reaches the build — there is no separate
       "run the generator" step to forget (which left SawdustPoints.cs stale, e.g. perp edits never compiled in).
       Runs UNCONDITIONALLY (no Inputs/Outputs): a file-timestamp incremental check is unsafe here, because an
       editor/linter/prior generation can leave the generated .cs NEWER than the .ps1 while still holding stale
       VALUES — MSBuild would then wrongly skip it. The generator instead writes the file ONLY when the content
       actually changes (write-if-different), so unchanged builds neither recompile nor churn the file. Called
       generate-only (no -Build/-Run) → just writes the file, no nested build / no recursion. Fires for any build
       path: test.bat, apply-sawing-animation.ps1 -Build, plain dotnet build, IDE.

       NOTE: SawdustPoints.cs is COMMITTED to source control and must stay tracked — do NOT add it to .gitignore.
       The default SDK Compile glob (**/*.cs) is expanded at project-EVALUATION time, before any target runs, so a
       file this target FIRST created mid-build would not be in @(Compile) for that build and compilation would fail
       on the missing FrontStart/etc. members. Because the file is committed, it is always present on a clean
       checkout and the glob always includes it; the target then just refreshes its contents (write-if-different). -->
  <Target Name="GenerateSawdustPoints" BeforeTargets="CoreCompile">
    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildProjectDirectory)\tools\apply-sawdust-points.ps1&quot;" />
  </Target>

  <!-- Strip // and /* */ comments from the BUILT JSON copy. The source assets under assets\ deliberately KEEP
       their developer //-docs; this runs string-aware (never touches handbook:// / https:// inside string
       values — see tools\strip-json-comments.ps1) over the build OUTPUT, so the game only ever sees clean JSON
       while the source stays documented. Idempotent + write-if-different, so repeated builds neither churn
       files nor double-strip.

       EVERY configuration, not just Release (was Release-only until 2026-07-31). Comments are NOT inert: a
       whole-line // comment that sits directly inside a top-level JSON ARRAY survives deserialisation as a
       JTokenType.Comment child of the JArray, and the recipe loaders iterate that array token-by-token —
       RecipeLoader.LoadRecipes logs "Failed to parse <kind> recipe: <file>" once per comment line, and
       RecipeRegistrySystem.loadRecipe (cooking) has no null guard and throws an NRE that kills the ENTIRE
       cooking-recipe registry for the whole server. So an unstripped Debug build is not "the same mod with
       docs" — it is a mod with broken recipes, and every dev smoke test ran against that. Stripping makes the
       dev build's JSON PARSE-equivalent to the shipped one — which is the property that matters here — but NOT
       byte-equivalent, and the earlier wording claiming byte-equivalence was wrong (measured 2026-08-04 in
       T07.01: 89 of 160 files differ). Two different strippers are involved: this target's
       tools/strip-json-comments.ps1 drops EVERY blank line, while CakeBuild's JsonCommentStripper, which
       writes the copy that is zipped, drops only lines a comment emptied. Both leave the parsed value
       identical (verified file by file, both copies, 0 differences), and that is what is being relied on. -->

  <Target Name="StripJsonComments" AfterTargets="Build">
    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildProjectDirectory)\tools\strip-json-comments.ps1&quot; -Path &quot;$(MSBuildProjectDirectory)\$(OutputPath)\assets&quot;" />
  </Target>

</Project>
